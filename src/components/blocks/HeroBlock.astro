---
const { title, subtitle } = Astro.props;
---
<section class="hero" style="padding: 4rem 2rem; background: #f4f4f5; text-align: center; border-radius: 8px; margin: 1rem 0;">
  <h1 style="font-size: 2.5rem; margin-bottom: 1rem; color: #18181b;">{title}</h1>
  <p style="font-size: 1.2rem; color: #52525b;">{subtitle}</p>
</section>