---
const { title, buttonText, buttonUrl } = Astro.props;
---
<section class="cta" style="padding: 3rem 2rem; background: #18181b; color: #ffffff; text-align: center; border-radius: 12px; margin: 2rem 0;">
  <h2 style="font-size: 2rem; margin-bottom: 1rem;">{title}</h2>
  <a href={buttonUrl} style="display: inline-block; padding: 0.75rem 1.5rem; background: #ffffff; color: #18181b; font-weight: 600; border-radius: 6px; text-decoration: none;">
    {buttonText}
  </a>
</section>