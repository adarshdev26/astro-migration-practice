---
const { heading, features = [] } = Astro.props;
---
<section class="feature-grid" style="padding: 3rem 0;">
  {heading && <h2 style="text-align: center; font-size: 2rem; margin-bottom: 2rem; color: #27272a;">{heading}</h2>}
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
    {features.map((feature) => (
      <div style="padding: 1.5rem; background: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px;">
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #18181b;">{feature.title}</h3>
        <p style="color: #52525b; font-size: 0.95rem; line-height: 1.5;">{feature.description}</p>
      </div>
    ))}
  </div>
</section>